# 환경변수 예시 — 복사해서 .env 로 쓸 것
# cp .env.example .env

# DB
DATABASE_URL=postgresql+asyncpg://personalab:password@localhost:5432/personalab

# LLM API
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30

# Figma
FIGMA_ACCESS_TOKEN=

# Agent Loop 설정 (8장 참조)
MAX_TURNS=10
PANEL_SIZE=100
DEV_PANEL_SIZE=20
DEV_MAX_TURNS=3

# 실행 모드
# live = 실제 LLM 호출 / cache = 저장된 결과 재생 (데모용)
RUN_MODE=live
