# 환경변수 예시 — 복사해서 .env 로 쓸 것
# cp .env.example .env

# DB
DATABASE_URL=postgresql+asyncpg://personalab:password@localhost:5432/personalab

# LLM API — 키는 서버의 .env에만 저장
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_MAX_OUTPUT_TOKENS=900
# 실제 페르소나 카드의 외부 전송은 명시적으로 허용하기 전까지 차단
ALLOW_PERSONA_TRANSMISSION=false
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30

# Figma
FIGMA_ACCESS_TOKEN=

# Agent Loop 설정 (8장 참조)
MAX_TURNS=10
PANEL_SIZE=100
DEV_PANEL_SIZE=20
DEV_MAX_TURNS=3

# 실행 모드
# live = 실제 LLM 호출 / cache = 저장된 결과 재생 (데모용)
RUN_MODE=live

# 이메일 로그인 (운영 HTTPS에서는 true로 설정)
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]

# 에이전트 판단 엔진: auto(기본) | rule(AI 호출 없음, 비용 없음) | llm
AGENT_ENGINE=auto
